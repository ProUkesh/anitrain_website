0:{"buildId":"EmVKRky_4Ersv6lEjP4pJ","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"post":{"slug":"workout-motivation-without-motivation","category":"FITNESS HABITS","title":"How to work out when motivation is low","description":"Use smaller workout targets, clear cues and flexible plans to keep exercising on days when motivation is low.","lead":"You do not need to feel motivated before every workout; you need a first step small enough to begin.","keywords":["workout motivation","exercise motivation","how to stay motivated to workout","fitness habits"],"stage":13,"activity":"stretch","takeaway":"Make starting easier, then decide what the rest of the session should be.","sections":[{"heading":"Shrink the first step","body":"Change clothes, open the workout, walk for five minutes or complete the warm-up. Starting with a small action reduces the pressure of deciding whether you can handle the entire session."},{"heading":"Keep a minimum version of the plan","body":"Your fallback workout could be ten minutes, one circuit or a walk. A lower minimum keeps the habit flexible without pretending a short session is identical to a full training day."},{"heading":"Use visible cues","body":"Prepare the mat, shoes or workout plan before the time you intend to train. A clear environment removes small decisions that can make starting feel harder than it needs to be."},{"heading":"Know when recovery is the better decision","body":"Low motivation and genuine fatigue are not always the same thing. If you are unusually exhausted or unwell, adjusting the session or resting can be more useful than forcing intensity."}]},"index":12,"total":14,"prevHref":"/blog/rest-day-active-recovery","nextHref":"/blog/anime-training-arc-realistic-plan"}],[["$","script","script-0",{"src":"/_next/static/chunks/1f3e3iqq5mikc.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},