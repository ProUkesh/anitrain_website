0:{"buildId":"Nd1cQcP5Lh31_JTWc3jWW","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"post":{"slug":"mobility-recovery-guide","category":"MOBILITY + RECOVERY","title":"Mobility and recovery for everyday training","description":"Learn how mobility, easy movement and recovery days can fit around strength and cardio training.","lead":"Recovery does not have to mean doing nothing, and mobility does not need an hour-long routine.","keywords":["mobility exercises","recovery workout","active recovery","mobility routine"],"stage":3,"activity":"mobility","takeaway":"Recovery supports the next good session; it is not time lost.","sections":[{"heading":"Use mobility where you need it","body":"Choose a few movements that match the areas you want to move more comfortably rather than collecting dozens of drills."},{"heading":"Easy movement can still be useful","body":"Walking, relaxed cycling or a gentle flow can help keep the routine moving on days when hard training is not appropriate."},{"heading":"Separate discomfort from progress","body":"Mobility work should be controlled. Sharp or unusual pain is a reason to stop and, when needed, speak with a qualified health professional."},{"heading":"Recover enough to train well again","body":"The purpose of recovery is to support future training. If every day is maximal, the next hard session often suffers."}]},"index":2,"total":14,"prevHref":"/blog/home-workouts-no-equipment","nextHref":"/blog/anime-inspired-workouts-beginners"}],[["$","script","script-0",{"src":"/_next/static/chunks/1f3e3iqq5mikc.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":["$","$1","h",{"children":[null,["$","$L8",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","2",{"name":"theme-color","content":"#000000"}],["$","meta",